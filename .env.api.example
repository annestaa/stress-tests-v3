# ==============================================================================
# 🚀 OPTIMIZED CONFIG - API Mode (Kejar Posisi 1!)
# ==============================================================================
# Copy file ini ke .env.api dan edit username kamu:
#   cp .env.api.example .env.api
#   nano .env.api
# ==============================================================================

# ============================================================================
# 🎮 GAME CONFIGURATION
# ============================================================================
API_BASE_URL=https://minigames.liputan6.com
MINIGAMES_USERNAME=zildjiannesta
GAME_CHOICE=tariktambang

# ============================================================================
# 🔥 OPTIMAL THROUGHPUT SETTINGS (Kejar Rank 1)
# ============================================================================

# Virtual Users - Multiple VUs = Parallel Exploitation!
# Semua VU share same token (cached 115s), tapi exploit parallel
# Recommended: 3-5 VUs untuk balance antara speed dan stability
VUS=5

# Loop Count - Unlimited iterations
LOOP_COUNT=9999

# ============================================================================
# ⚡ ADAPTIVE BATCH SIZE (Auto-adjust based on performance)
# ============================================================================

# Initial batch size (start point)
INITIAL_BATCH_SIZE=6

# Minimum batch size (safety floor)
MIN_BATCH_SIZE=2

# Maximum batch size (performance ceiling)
MAX_BATCH_SIZE=10

# ============================================================================
# ⏱️ TIMING CONFIGURATION
# ============================================================================

# Gameplay duration (minimum 7s for anti-cheat)
GAMEPLAY_DURATION_SEC=7.5

# Round delay (delay between rounds)
# Lower = faster, but may trigger rate limits
ROUND_DELAY_SEC=1.2

# Time left when submitting (affects points calculation)
TIME_LEFT=22

# ============================================================================
# 🎯 PERFORMANCE TARGETS
# ============================================================================
# With this config, expect:
# - Points per 2 minutes: 3,000-5,000
# - Points per hour: 90,000-150,000
# - Time to 1 million: 7-11 hours
# - Success rate: 75-85%
# ============================================================================

# ============================================================================
# 🔧 CAPTCHA SOLVER CONFIGURATION
# ============================================================================

# reCAPTCHA Site Key
RECAPTCHA_SITEKEY=6Ld_e78qAAAAAF1Uwh807r9U5E9w1lWbQvE9k7N2

# Token Sync Daemon (managed by start.sh)
CDP_URL=http://127.0.0.1:9222

# Captcha intervals
CAPTCHA_MIN_INTERVAL_SEC=6
CAPTCHA_DOS_COOLDOWN_SEC=90

# ============================================================================
# 🌩️ CLOUD SOLVER (OPTIONAL - HIGHLY RECOMMENDED!)
# ============================================================================
# Uncomment and add your API key for BEST performance:
# - No IP limit from Google
# - 95-99% success rate (vs 70-80% with Wit.ai)
# - Can be MORE aggressive
# - Cost: ~$10-15 for 1 million points
#
# Get CapSolver: https://www.capsolver.com/
# CAPSOLVER_API_KEY=your_key_here
#
# Or 2Captcha: https://2captcha.com/
# TWOCAPTCHA_API_KEY=your_key_here

# ============================================================================
# 🎤 WIT.AI AUDIO SOLVER (Already Included!)
# ============================================================================
# Token Wit.ai already embedded in token_sync.js
# Default: YP37OWAPEEWGZDIKUZS6SKS2H3IDOPB5
# Works out of the box, no setup needed!
#
# Optional: Use your own Wit.ai token
# WITAI_ACCESS_TOKEN=your_token_here

# ============================================================================
# 🌐 PROXY (Optional)
# ============================================================================
# Use proxy to rotate IP and avoid rate limits
# PROXY_SERVER=http://username:password@proxy.com:8080
# HTTP_PROXY=socks5://proxy.com:1080

# ============================================================================
# 📊 TUNING GUIDELINES
# ============================================================================
#
# 🐢 Conservative (High Success Rate, Slower):
#   VUS=1
#   INITIAL_BATCH_SIZE=3
#   MAX_BATCH_SIZE=5
#   ROUND_DELAY_SEC=2.0
#   Expected: 50,000-70,000 points/hour
#
# ⚖️ Balanced (Default - Recommended):
#   VUS=3-5
#   INITIAL_BATCH_SIZE=5-6
#   MAX_BATCH_SIZE=8-10
#   ROUND_DELAY_SEC=1.2-1.5
#   Expected: 90,000-150,000 points/hour
#
# 🚀 Aggressive (Max Speed, Higher Error Risk):
#   VUS=5-8
#   INITIAL_BATCH_SIZE=8
#   MAX_BATCH_SIZE=12
#   ROUND_DELAY_SEC=1.0
#   Expected: 150,000-200,000 points/hour
#
# ⚡ Extreme (With Cloud Solver Only!):
#   VUS=10
#   INITIAL_BATCH_SIZE=10
#   MAX_BATCH_SIZE=15
#   ROUND_DELAY_SEC=0.8
#   CAPSOLVER_API_KEY=required
#   Expected: 200,000-300,000 points/hour
#
# ============================================================================

# ============================================================================
# 🎯 TROUBLESHOOTING
# ============================================================================
#
# Problem: Too many 429 errors
# Solution: Reduce VUS, reduce MAX_BATCH_SIZE, increase ROUND_DELAY_SEC
#
# Problem: Low success rate (< 60%)
# Solution: Reduce VUS to 1-2, reduce batch sizes, increase delays
#
# Problem: Token not maximized (< 20 wins per 2 min)
# Solution: Increase VUS, increase batch sizes, reduce delays
#
# Problem: Google cooldown frequent
# Solution: Add CAPSOLVER_API_KEY or reduce request frequency
#
# ============================================================================

