# Game Configuration
MINIGAMES_USERNAME=zildjiannesta
GAME_CHOICE=tariktambang
API_BASE_URL=https://minigames.liputan6.com

# reCAPTCHA Configuration
RECAPTCHA_SITEKEY=6Ld_e78qAAAAAF1Uwh807r9U5E9w1lWbQvE9k7N2

# ============================================================================
# 🔥 ADAPTIVE RATE LIMITING - Key to avoiding 429/500 errors
# ============================================================================

# Batch Size Configuration
# Start aggressive (8), system will auto-adjust based on success rate
INITIAL_BATCH_SIZE=8
MIN_BATCH_SIZE=2
MAX_BATCH_SIZE=12

# Target Success Rate (75% = good balance between speed and reliability)
# System will slow down if success rate drops below this
TARGET_SUCCESS_RATE=0.75

# Aggressive Mode (true = maximize throughput, false = conservative)
AGGRESSIVE_MODE=true

# ============================================================================
# TIMING CONFIGURATION
# ============================================================================

# Gameplay duration (must be >= 7s for anti-cheat)
GAMEPLAY_DURATION_SEC=7.5

# Round delay range (system picks randomly between min-max)
MIN_ROUND_DELAY_SEC=1.0
MAX_ROUND_DELAY_SEC=3.0

# Time left when submitting score (affects points)
TIME_LEFT=22

# ============================================================================
# K6 LOAD TEST CONFIGURATION
# ============================================================================

# Virtual Users (REKOMENDASI: 1-2 untuk menghindari konflik)
VUS=1

# Loop count (9999 = run indefinitely)
LOOP_COUNT=9999

# ============================================================================
# CAPTCHA SOLVER CONFIGURATION
# ============================================================================

# CDP Chrome remote debugging
CDP_URL=http://127.0.0.1:9222

# Captcha solver intervals (leave as is)
CAPTCHA_MIN_INTERVAL_SEC=6
CAPTCHA_DOS_COOLDOWN_SEC=90

# Cloud solver (optional - recommended for best results)
# CAPSOLVER_API_KEY=your_key_here
# TWOCAPTCHA_API_KEY=your_key_here

# Audio solver tokens
# WITAI_ACCESS_TOKEN=your_token_here
# OPENAI_API_KEY=your_key_here

# ============================================================================
