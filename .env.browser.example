# ==============================================================================
# Konfigurasi Bot BROWSER AUTOMATION UI (browser_play.js)
# ==============================================================================

# Target Web & Game
BASE_URL=https://kemerdekaan.liputan6.com
MINIGAMES_USERNAME=zildjiannesta # required to change
# Pilihan game: "tariktambang", "panjatpinang", "balapkarung", atau "all"
GAME_CHOICE=tariktambang

# ==============================================================================
# Browser UI & Anti-Ban Settings
# ==============================================================================
# Mode Headless Browser (true = background, false = buka jendela Chromium visual)
HEADLESS=false
K6_BROWSER_HEADLESS=false

# Akun Chrome / User Data Profile untuk reCAPTCHA Reputation
CHROME_USER_EMAIL=252011057@asia.ac.id # required to change

# Solver Mode ("auto", "audio", "image")
CAPTCHA_MODE=auto

# Proxy Server (Opsional)
PROXY_SERVER=
HTTP_PROXY=

# reCAPTCHA Audio Challenge Solver (Speech-to-Text)
WITAI_ACCESS_TOKEN=hawo # required to change, create wit.ai client token (https://wit.ai/)
OPENAI_API_KEY=
HF_API_KEY=

# Credential Cloud Solvers (Opsional)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
RECAPTCHA_SITEKEY=6Ld_e78qAAAAAF1Uwh807r9U5E9w1lWbQvE9k7N2
GRECAPTCHA_TOKEN=

# ==============================================================================
# k6 Concurrency & Round Settings (Browser Mode)
# ==============================================================================
# Rekomendasi Browser Mode: VUS=1 untuk menghindari tabrakan audio reCAPTCHA
VUS=1
LOOP_COUNT=50

# Jeda antar ronde (detik)
ROUND_DELAY_SEC=4
