# ==============================================================================
# Konfigurasi Bot / Load Test Mini Games Kemerdekaan (k6)
# ==============================================================================

# Target Web & Game
BASE_URL=https://kemerdekaan.liputan6.com
MINIGAMES_USERNAME=zildjiannesta
# Pilihan game: "tariktambang", "panjatpinang", "balapkarung", atau "all"
GAME_CHOICE=tariktambang

# ==============================================================================
# Anti-Ban & Browser Configuration
# ==============================================================================
# Mode Headless Browser (true / false)
HEADLESS=true
K6_BROWSER_HEADLESS=true

# Akun Chrome / User Data Profile untuk reCAPTCHA Reputation
CHROME_USER_EMAIL=252011057@asia.ac.id


# Hubungkan ke Google Chrome Asli via CDP (Sangat direkomendasikan untuk 1-Click Pass)
# Jalankan Chrome: /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
CDP_URL=http://127.0.0.1:9222

# Proxy Server (Opsional: SOCKS5 / HTTP Proxy untuk merotasi IP dan bypass IP Ban)
# Contoh: PROXY_SERVER=http://user:pass@proxy-ip:port atau PROXY_SERVER=socks5://127.0.0.1:1080
PROXY_SERVER=
HTTP_PROXY=

# ==============================================================================
# Solver reCAPTCHA (Anti-Ban & Multi-Strategy)
# ==============================================================================
# Mode Solver: "auto" (Audio/Wit.ai -> Cloud Fallback), "audio" (Wit.ai), "image" (CapSolver/2Captcha)
CAPTCHA_MODE=auto

# Interval minimum antar eksekusi solver lokal (detik) untuk mencegah spamming Google
CAPTCHA_MIN_INTERVAL_SEC=6
# Durasi cooldown saat Google membatasi IP (DOS block / automated queries)
CAPTCHA_DOS_COOLDOWN_SEC=90

# reCAPTCHA Audio Challenge Solver (Speech-to-Text)
WITAI_ACCESS_TOKEN=YP37OWAPEEWGZDIKUZS6SKS2H3IDOPB5
OPENAI_API_KEY=
HF_API_KEY=

# Cloud 3rd-Party Solvers (Rekomendasi Utama: 100% Bebas IP Ban karena request dari cloud proxy pool)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
RECAPTCHA_SITEKEY=6Ld_e78qAAAAAF1Uwh807r9U5E9w1lWbQvE9k7N2
GRECAPTCHA_TOKEN=

# ==============================================================================
# k6 Performance & Concurrency Settings
# ==============================================================================
# Rekomendasi Anti-Ban: VUS=1 agar request sekuensial dan tidak bentrok reCAPTCHA
VUS=1
LOOP_COUNT=100

# Game Simulation Settings (Strategi 7.8s)
TIME_LEFT=22
SIMULATE_GAMEPLAY_DELAY=true
GAMEPLAY_DURATION_SEC=7.8

# Jeda antar ronde (detik) - sistem akan menambahkan jitter acak 0-2 detik secara otomatis
ROUND_DELAY_SEC=4
