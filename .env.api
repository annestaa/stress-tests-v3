# ==============================================================================
# k6 Performance & Concurrency Settings (API Mode - Pipeline)
# ==============================================================================
VUS=5
LOOP_COUNT=9999999

# Game Simulation Settings (1 Token per 2+ Menit, Pipeline Overlapping Sessions)
TIME_LEFT=28

# Jeda antar session open (0.5s = stagger, pipeline buka terus selama token valid)
ROUND_DELAY_SEC=0.5

# Target durasi bermain per-sesi (session->submit). Tier: <10s=50pt, 10-20s=30pt, >20s=10pt
# 8.5s = aman di tier 50pts, tidak terlalu cepat
TARGET_DURATION_SEC=8.5

# Jeda antar request individual (open session ke open session berikutnya)
# 0.5s = ~30-40 games/menit karena pipeline overlap
REQUEST_STAGGER_SEC=0.5
